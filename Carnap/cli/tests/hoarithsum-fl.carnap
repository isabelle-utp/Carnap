-- Sanity tests for hoArithSumFL.
--
-- Demonstrates the new rules: PolyEq (ring-equality decision procedure),
-- ΣZ / ΣS (recursion equations for the bounded sum), Ind (induction),
-- and the parse-time abbreviation `1 ≡ 0'`.

logic hoArithSumFL

--------------------------------------------------------------------------------
-- Polynomial-equality decision procedure
--------------------------------------------------------------------------------

-- Pure ring identity. The parser puts `+` and `*` at the same precedence
-- level, so we fully parenthesize.
lemma RingSquare: |- (x + y) * (x + y) = ((x*x) + ((x*y) + (y*x))) + (y*y)
begin
(x + y) * (x + y) = ((x*x) + ((x*y) + (y*x))) + (y*y) :Poly
end

-- '1' parsed as 0'
lemma OnePlusOne: |- 1 + 1 = 0''
begin
1 + 1 = 0'' :Poly
end

-- Σ-terms appear as opaque indeterminates: doubling matches itself.
lemma SumOpaque: |- (Σx=0..n. x) + (Σx=0..n. x) = (0' + 0') * (Σx=0..n. x)
begin
(Σx=0..n. x) + (Σx=0..n. x) = (0' + 0') * (Σx=0..n. x) :Poly
end

--------------------------------------------------------------------------------
-- Σ-recursion
--------------------------------------------------------------------------------

lemma SigmaZero: |- Σx=0..0. x = 0
begin
Σx=0..0. x = 0 :ΣZ
end

lemma SigmaSucc: |- Σx=0..0'. x = (Σx=0..0. x) + 0'
begin
Σx=0..0'. x = (Σx=0..0. x) + 0' :ΣS
end
