-- Triangular-number closed form, 2·Σy=0..x. y = x·(x+1), proved by
-- induction on x in hoArithSumFL (Fitch-style).
--
-- The induction rule cites the base-case line and a subproof from the
-- assumption P(t) to a derivation of P(t').
logic hoArithSumFL

-- Sanity: base case in isolation.
lemma TriangularBase: |- (1 + 1) * (Σx=0..0. x) = 0 * (0 + 1)
begin
Σx=0..0. x = 0 :ΣZ
(1 + 1) * 0 = 0 * (0 + 1) :Poly
(1 + 1) * (Σx=0..0. x) = 0 * (0 + 1) :LL 1, 2
end

-- Any numerals are shown as their respective number but are 0'...n'
-- Need to handle the variable' case
-- Variant of induction rule with "+1" as the goal
-- Keep successor versions of rules, create versions with +1 - e.g. S+ in addition to SS

lemma TriangularClosedForm: |- Ax((1+1) * (Sy=0..x. y) = x * (x + 1))
begin
Σy=0..0. y = 0 :ΣZ
(1+1) * 0 = 0 * (0 + 1) :Poly
(1+1) * (Σy=0..0. y) = 0 * (0 + 1) :LL 1, 2
   (1+1) * (Σy=0..t. y) = t * (t + 1) :AS
   Σy=0..t+1. y = (Σy=0..t. y) + (t+1) :ΣS
   (1+1) * ((Σy=0..t. y) + t') = ((1+1) * (Σy=0..t. y)) + ((1+1) * t') :Poly
   (1+1) * (Σy=0..t'. y) = ((1+1) * (Σy=0..t. y)) + ((1+1) * t') :LL 5, 6
   (1+1) * (Σy=0..t'. y) = (t * (t + 1)) + ((1+1) * t') :LL 4, 7
   (t * (t + 1)) + ((1+1) * t') = t' * (t' + 1) :Poly
   (1+1) * (Σy=0..t'. y) = t' * (t' + 1) :LL 9, 8
Ax((1+1) * (Σy=0..x. y) = x * (x + 1)) :Ind 3, 4-10
end
